{
  "name": "ct",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "agent-tool": "agent-tool",
    "agent:run": "agent-tool run",
    "agents:sync": "agent-tool skills install --apply",
    "agents:check": "agent-tool skills check",
    "build": "turbo run build",
    "check": "biome check --error-on-warnings . && bun run typecheck && bun run agents:check",
    "typecheck": "turbo run check && tsc -p scripts/tsconfig.json",
    "format": "biome check --write .",
    "test": "bun test packages scripts",
    "test:browser": "playwright test",
    "dev": "turbo run dev",
    "hooks:install": "git config core.hooksPath scripts/git/hooks",
    "deploy": "bun scripts/deploy/deploy.ts",
    "deploy:preview": "bun scripts/deploy/deploy.ts --dry-run",
    "package:smoke": "bun scripts/testing/packageSmoke.ts",
    "test:extension": "bun run --cwd packages/extension lint:package",
    "admin:user": "node scripts/admin/adminUser.ts"
  },
  "devDependencies": {
    "@a2f0/agent-tool": "0.1.15",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "happy-dom": "21.0.3",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "wrangler": "4.151.1"
  }
}
