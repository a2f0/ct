{
  "name": "ct",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "agent-tool": "agent-tool",
    "agent:run": "agent-tool run",
    "agent:logs": "agent-tool logs",
    "agents:sync": "agent-tool skills install --apply && agent-tool permissions install --apply",
    "agents:check": "agent-tool skills check && agent-tool permissions check",
    "build": "turbo run build",
    "check": "agent-tool run-group scripts/testing/check.json",
    "typecheck": "turbo run check && tsc -p scripts/tsconfig.json",
    "format": "biome check --write .",
    "test": "bun test --parallel packages scripts",
    "test:browser": "playwright test",
    "test:native": "bun scripts/testing/nativeE2e.ts",
    "dev": "turbo run dev",
    "hooks:install": "agent-tool hooks install --apply",
    "deploy": "bun scripts/deploy/deploy.ts",
    "deploy:preview": "bun scripts/deploy/deploy.ts --dry-run",
    "package:smoke": "bun scripts/testing/packageSmoke.ts",
    "test:extension": "bun run --cwd packages/extension lint:package",
    "admin:user": "node scripts/admin/adminUser.ts",
    "verify": "agent-tool run-group scripts/testing/verify.json",
    "lint:branch-name": "agent-tool branch check",
    "release:plan": "agent-tool release plan packages/client/package.json",
    "lint:rubocop": "bun run --cwd packages/app-capacitor lint:rubocop",
    "mobile:sync": "bun run --cwd packages/app-capacitor build && bun run --cwd packages/app-capacitor cap:sync",
    "mobile:ios": "bun run mobile:sync && bun run --cwd packages/app-capacitor cap:open:ios",
    "mobile:android": "bun run mobile:sync && bun run --cwd packages/app-capacitor cap:open:android",
    "mobile:build:ios": "bun run --cwd packages/app-capacitor ios:build-release",
    "mobile:upload:ios": "bun run --cwd packages/app-capacitor ios:upload-release",
    "mobile:build:android": "bun run --cwd packages/app-capacitor android:build-release",
    "mobile:upload:android": "bun run --cwd packages/app-capacitor android:upload-release"
  },
  "devDependencies": {
    "@a2f0/agent-tool": "0.1.28",
    "@biomejs/biome": "2.5.15",
    "@ct/api": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "happy-dom": "21.0.3",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "wrangler": "4.151.1"
  }
}
