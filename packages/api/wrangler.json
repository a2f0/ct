{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ct-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ct.a2f0.net",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ct",
      "database_id": "a71d26e8-beac-4481-8fb7-5850975e6f2e",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "INGEST_LIMITER",
      "namespace_id": "782001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "SITES": {
      "skyline": {
        "https://skyline.devopsrockstars.com": "production"
      },
      "a2f0-net": {
        "https://a2f0.net": "production",
        "https://resume.a2f0.net": "production",
        "https://demo.a2f0.net": "production",
        "https://drive.a2f0.net": "production"
      },
      "devopsrockstars": {
        "https://devopsrockstars.com": "production",
        "https://www.devopsrockstars.com": "production",
        "https://staging.devopsrockstars.com": "staging"
      },
      "balebase": {
        "https://balebase.com": "production",
        "https://app.balebase.com": "production",
        "https://website-staging.balebase.com": "staging",
        "https://app-staging.balebase.com": "staging"
      },
      "tearleads": {
        "https://tearleads.com": "production",
        "https://app.tearleads.com": "production",
        "https://demo.tearleads.com": "production",
        "https://website-staging.tearleads.com": "staging",
        "https://app-staging.tearleads.com": "staging",
        "https://demo-staging.tearleads.com": "staging"
      },
      "commandsnippets": {
        "https://commandsnippets.com": "production",
        "https://app.commandsnippets.com": "production",
        "https://website-staging.commandsnippets.com": "staging",
        "https://app-staging.commandsnippets.com": "staging"
      },
      "dnbm": {
        "https://dnbm.a2f0.net": "production"
      },
      "nc": {
        "https://nc.a2f0.net": "production"
      },
      "rn-sandbox": {
        "https://rn-sandbox.a2f0.net": "production"
      },
      "continuity": {
        "https://continuity.tearleads.com": "production"
      }
    }
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": false
  }
}
