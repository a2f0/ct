{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ct-admin",
  "main": "src/admin.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ct-admin.a2f0.net",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ct",
      "database_id": "a71d26e8-beac-4481-8fb7-5850975e6f2e"
    }
  ],
  "ratelimits": [
    {
      "name": "READ_LIMITER",
      "namespace_id": "782002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "SITES": {
      "skyline": {
        "https://skyline.devopsrockstars.com": "production"
      },
      "a2f0-net": {
        "https://a2f0.net": "production"
      },
      "devopsrockstars": {
        "https://devopsrockstars.com": "production",
        "https://www.devopsrockstars.com": "production",
        "https://staging.devopsrockstars.com": "staging"
      },
      "balebase": {
        "https://balebase.com": "production",
        "https://app.balebase.com": "production",
        "https://website-staging.balebase.com": "staging",
        "https://app-staging.balebase.com": "staging"
      }
    }
  },
  "observability": {
    "enabled": false
  }
}
