{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ct-admin",
  "main": "src/admin.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ct-admin.a2f0.net", "custom_domain": true }],
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ct",
      "database_id": "a71d26e8-beac-4481-8fb7-5850975e6f2e"
    }
  ],
  "ratelimits": [
    {
      "name": "READ_LIMITER",
      "namespace_id": "782002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "vars": { "SITES": { "skyline": ["https://skyline.devopsrockstars.com"] } },
  "observability": { "enabled": false }
}
