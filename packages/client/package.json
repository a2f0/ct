{
  "name": "@a2f0/ct-client",
  "version": "0.1.2",
  "type": "module",
  "license": "UNLICENSED",
  "description": "Explicitly initialized, batched click tracking with browser opt-out support",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2f0/ct.git",
    "directory": "packages/client"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --target browser --outdir dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json"
  }
}
