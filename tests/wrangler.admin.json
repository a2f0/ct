{
  "name": "ct-admin-test",
  "main": "../packages/api/src/admin.ts",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "../packages/admin/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ct-test",
      "database_id": "11111111-1111-4111-8111-111111111111"
    }
  ],
  "ratelimits": [
    {
      "name": "READ_LIMITER",
      "namespace_id": "782004",
      "simple": {
        "limit": 1000,
        "period": 60
      }
    }
  ],
  "vars": {
    "SITES": {
      "skyline": {
        "http://127.0.0.1:4174": "production"
      }
    },
    "BETTER_AUTH_URL": "http://127.0.0.1:4176",
    "BETTER_AUTH_SECRET": "ct-isolated-browser-test-secret-not-for-production-0001"
  },
  "compatibility_flags": ["nodejs_compat"]
}
