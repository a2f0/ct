{
  "label": "check",
  "steps": [
    {
      "label": "lint",
      "command": [
        "bunx",
        "--no-install",
        "biome",
        "check",
        "--error-on-warnings",
        "."
      ]
    },
    {
      "label": "typecheck",
      "command": ["bun", "run", "typecheck"]
    },
    {
      "label": "rubocop",
      "command": ["bun", "run", "lint:rubocop"]
    },
    {
      "label": "agents",
      "command": ["bun", "run", "agents:check"]
    }
  ]
}
