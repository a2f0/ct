{
  "schemaVersion": 1,
  "subject": {
    "maxLength": 50
  },
  "merge": {
    "requiredChecks": [
      {
        "name": "verify",
        "workflow": "CI"
      }
    ]
  },
  "versions": {
    "packages": ["packages/client"]
  },
  "images": {
    "targets": {
      "extension": {
        "dir": "packages/extension/dist/icons",
        "outputs": [
          {
            "path": "16.png",
            "size": 16,
            "layers": [
              {
                "source": "logo"
              }
            ]
          },
          {
            "path": "32.png",
            "size": 32,
            "layers": [
              {
                "source": "logo"
              }
            ]
          },
          {
            "path": "48.png",
            "size": 48,
            "layers": [
              {
                "source": "logo"
              }
            ]
          },
          {
            "path": "128.png",
            "size": 128,
            "layers": [
              {
                "source": "logo"
              }
            ]
          }
        ]
      },
      "favicons": {
        "dir": "packages/admin/public",
        "outputs": [
          {
            "path": "favicon.svg",
            "layers": [
              {
                "source": "logo"
              }
            ]
          },
          {
            "path": "favicon.ico",
            "sizes": [16, 32, 48],
            "layers": [
              {
                "source": "logo"
              }
            ]
          },
          {
            "path": "apple-touch-icon.png",
            "size": 180,
            "opaque": true,
            "layers": [
              {
                "fill": "#102723"
              },
              {
                "source": "logo",
                "scale": 0.8
              }
            ]
          }
        ]
      },
      "native": {
        "dir": "packages/app-capacitor",
        "outputs": [
          {
            "path": "ios/App/App/Assets.xcassets/AppIcon.appiconset/AppIcon-512@2x.png",
            "size": 1024,
            "opaque": true,
            "layers": [
              {
                "fill": "#102723"
              },
              {
                "source": "logo",
                "scale": 0.8
              }
            ]
          },
          {
            "path": "ios/App/App/Assets.xcassets/Splash.imageset/splash-2732x2732{variant}.png",
            "size": 2732,
            "variants": {
              "": 1,
              "-1": 1,
              "-2": 1
            },
            "opaque": true,
            "layers": [
              {
                "fill": "#102723"
              },
              {
                "source": "logo",
                "scale": 0.2
              }
            ]
          },
          {
            "path": "android/app/src/main/res/values/ic_launcher_background.xml",
            "colors": {
              "ic_launcher_background": "#102723"
            }
          },
          {
            "path": "android/app/src/main/res/mipmap-{variant}/ic_launcher.png",
            "size": 48,
            "variants": "android",
            "layers": [
              {
                "source": "logo"
              }
            ]
          },
          {
            "path": "android/app/src/main/res/mipmap-{variant}/ic_launcher_round.png",
            "size": 48,
            "variants": "android",
            "mask": "circle",
            "layers": [
              {
                "fill": "#102723"
              },
              {
                "source": "logo",
                "scale": 0.8
              }
            ]
          },
          {
            "path": "android/app/src/main/res/mipmap-{variant}/ic_launcher_foreground.png",
            "size": 108,
            "variants": "android",
            "layers": [
              {
                "source": "logo",
                "scale": 0.6
              }
            ]
          }
        ]
      }
    }
  },
  "branch": {
    "types": [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "chore",
      "revert"
    ],
    "exempt": ["main"],
    "maxLength": null
  },
  "hooks": {
    "files": [
      {
        "source": "scripts/git/hooks/commit-msg",
        "target": "commit-msg",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-push",
        "target": "pre-push",
        "executable": true
      }
    ]
  },
  "commits": {
    "signatures": "present",
    "signatureHeaderFallback": true,
    "rejectCoauthors": true,
    "subjects": true
  }
}
