{
  "schemaVersion": 1,
  "subject": {
    "maxLength": 50
  },
  "merge": {
    "requiredChecks": [
      {
        "name": "verify",
        "workflow": "CI"
      }
    ]
  },
  "versions": {
    "packages": ["packages/client"]
  },
  "images": {
    "targets": {
      "extension": {
        "dir": "packages/extension/dist/icons",
        "outputs": [
          {
            "path": "16.png",
            "size": 16,
            "layers": [
              {
                "source": "logo"
              }
            ]
          },
          {
            "path": "32.png",
            "size": 32,
            "layers": [
              {
                "source": "logo"
              }
            ]
          },
          {
            "path": "48.png",
            "size": 48,
            "layers": [
              {
                "source": "logo"
              }
            ]
          },
          {
            "path": "128.png",
            "size": 128,
            "layers": [
              {
                "source": "logo"
              }
            ]
          }
        ]
      },
      "favicons": {
        "dir": "packages/admin/public",
        "outputs": [
          {
            "path": "favicon.svg",
            "layers": [
              {
                "source": "logo"
              }
            ]
          },
          {
            "path": "favicon.ico",
            "sizes": [16, 32, 48],
            "layers": [
              {
                "source": "logo"
              }
            ]
          },
          {
            "path": "apple-touch-icon.png",
            "size": 180,
            "opaque": true,
            "layers": [
              {
                "fill": "#102723"
              },
              {
                "source": "logo",
                "scale": 0.8
              }
            ]
          }
        ]
      }
    }
  },
  "branch": {
    "types": [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "chore",
      "revert"
    ],
    "exempt": ["main"],
    "maxLength": null
  },
  "hooks": {
    "files": [
      {
        "source": "scripts/git/hooks/commit-msg",
        "target": "commit-msg",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-push",
        "target": "pre-push",
        "executable": true
      }
    ]
  },
  "commits": {
    "signatures": "present",
    "signatureHeaderFallback": true,
    "rejectCoauthors": true,
    "subjects": true
  }
}
